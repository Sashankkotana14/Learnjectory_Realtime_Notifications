PORT=5000
JWT_SECRET=change_me_to_a_long_random_string
SEED_DEMO=true
# CORS_ORIGIN=http://localhost:5173
# Optional: YouTube Data API v3 key - enables real video results in Career Compass (search links work without it)
# YOUTUBE_API_KEY=

# ---- Part 2B ----
# My Vault: files are stored AES-256-GCM encrypted under backend/storage/vault (never served statically).
# VAULT_KEY=a-long-random-passphrase     # if unset, a random key file is generated at storage/vault/.vault.key - BACK IT UP (without the key, files cannot be decrypted)
# VAULT_DIR=                              # default: backend/storage/vault
# VAULT_MAX_MB=10                         # max size per uploaded file
# VAULT_QUOTA_MB=200                      # max total per user
# Opportunities: Remotive and Arbeitnow need no key. Adzuna is optional (free key at https://developer.adzuna.com)
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=
# ADZUNA_COUNTRY=in                       # gb, us, in, au, ca, de, fr ...
